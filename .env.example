# Database
# URL de conexão com PostgreSQL (via Docker Compose)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://sol_user:sol_password_dev@localhost:5432/sol_db"

# Environment
# Ambiente de execução: development | production | test
NODE_ENV="development"

# NextAuth.js
# Secret usado para encriptar tokens JWT
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# URL base da aplicação
# Development: http://localhost:3000
# Production: https://seu-dominio.com
NEXTAUTH_URL="http://localhost:3000"

# OpenAI (será usado em stories futuras - Epic 2)
# OPENAI_API_KEY="sk-..."

# Stripe (será usado em stories futuras - Epic 3)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
