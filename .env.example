# Database
# URL de conexão com PostgreSQL (via Docker Compose)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://sol_user:sol_password_dev@localhost:5432/sol_db"

# Environment
# Ambiente de execução: development | production | test
NODE_ENV="development"

# NextAuth.js
# AUTH_SECRET é o nome padrão do NextAuth v5 (obrigatório para o @auth/core)
# NEXTAUTH_SECRET mantido por retrocompatibilidade
# Gere com: openssl rand -base64 32
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# URL base da aplicação
# Development: http://localhost:3000
# Production: https://seu-dominio.com
NEXTAUTH_URL="http://localhost:3000"

# OpenAI (Story 2.3 - OpenAI Integration)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL_DEFAULT="gpt-4o-mini"
OPENAI_MODEL_FINAL="gpt-4o"

# Stripe (Story 3.3 - Pacotes de Créditos & Checkout)
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys
# Use chaves de TEST (sk_test_...) para desenvolvimento
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Webhook (Story 3.4 - Processamento de Pagamentos)
# Obtenha em: https://dashboard.stripe.com/webhooks
# Development local: use Stripe CLI → stripe listen --forward-to localhost:3000/api/webhooks/stripe
# O CLI exibe o STRIPE_WEBHOOK_SECRET ao iniciar (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Pricing (configurado via PricingConfig no banco — sem variáveis de ambiente necessárias)
# Valores padrão definidos na migration/seed:
#   CREDITS_PER_M_INPUT=500, CREDITS_PER_M_OUTPUT=2000, MAX_OUTPUT_TOKENS=8192

# AssemblyAI (Story 7.1 - Video Processing)
# Obtenha sua chave em: https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY="your-assemblyai-api-key"

# Video Processing Limits
VIDEO_MAX_DURATION_SECONDS=300
VIDEO_MAX_SIZE_MB=500
VIDEO_TEMP_DIR="/tmp/sol-uploads/"
