{
  "name": "sol",
  "version": "0.1.0",
  "private": true,
  "description": "Sol — SaaS de Criação de Ofertas com IA Conversacional",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "npm -w @sol/db run generate",
    "db:push": "npm -w @sol/db run push",
    "db:migrate": "npm -w @sol/db run migrate",
    "db:studio": "npm -w @sol/db run studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.7.0"
}
