{
  "name": "sol-saas",
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm -C packages/db run db:migrate",
    "db:deploy": "pnpm -C packages/db run db:deploy",
    "db:studio": "pnpm -C packages/db run db:studio",
    "db:push": "pnpm -C packages/db run db:push",
    "db:generate": "pnpm -C packages/db run db:generate"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
